{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/lord-taylor",
      "schedule": "17 5 * * *"
    },
    {
      "path": "/api/cron/giglio",
      "schedule": "3 7 * * *"
    },
    {
      "path": "/api/cron/price-alerts",
      "schedule": "11 7 * * *"
    }
  ]
}